{
  "name": "rahma",
  "version": "0.1.0",
  "description": "Hospital management REST API",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon --exec \"node --env-file=.env\" src/server.js",
    "start": "node --env-file=.env src/server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "nodemonConfig": {
    "watch": ["src"],
    "ext": "js,json"
  },
  "license": "ISC",
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10"
  }
}
